# WatchVibe — environment (source with: set -a; . .env; set +a)
ANDROID_HOME=/home/v/Android/Sdk
JAVA_HOME=/home/v/.sdkman/candidates/java/21.0.9-tem
WEAR_SERIAL=192.168.x.x:xxxxx
PHONE_SERIAL=192.168.x.x:xxxxx

# Release signing keystore — used by 'make release' and 'make install-release'
# Generate: keytool -genkey -keystore release.keystore -alias release ...
RELEASE_KEYSTORE=release.keystore
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=release
RELEASE_KEY_PASSWORD=

# GitHub account used by this repo's credential helper.
# The helper switches to this account for git push/pull, then
# restores the previously active account. Set to the repo owner.
GH_REPO_USER=yieldinghartebeest13
