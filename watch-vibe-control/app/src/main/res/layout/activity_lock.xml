<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#1a1a2e">

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.20" />

    <!-- Calculator display -->
    <TextView
        android:id="@+id/calcDisplay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="0"
        android:textColor="#e0e0e0"
        android:textSize="26sp"
        android:gravity="end|center_vertical"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:background="#1e1e35"
        android:maxLines="1"
        android:layout_marginBottom="16dp" />

    <!-- Button macros: digit=72dp bg=#2a2a3e fg=#fff 22sp, op=bg=#3a3a2e fg=#a0c0a0, fn=bg=#3a2e2e fg=#c0a0a0 -->

    <!-- Row 1 -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/key7" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="7" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key8" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="8" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key9" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="9" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/keyDiv" android:layout_width="72dp" android:layout_height="72dp" android:gravity="center" android:text="÷" android:textColor="#8aba8a" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/key4" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="4" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key5" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="5" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key6" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="6" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/keyMul" android:layout_width="72dp" android:layout_height="72dp" android:gravity="center" android:text="×" android:textColor="#8aba8a" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/key1" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="1" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key2" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="2" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key3" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="3" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/keySub" android:layout_width="72dp" android:layout_height="72dp" android:gravity="center" android:text="−" android:textColor="#8aba8a" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/keyClear" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="C" android:textColor="#c09090" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/key0" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="0" android:textColor="#ffffff" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/keyEq" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:gravity="center" android:text="=" android:textColor="#90c090" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
        <TextView android:id="@+id/keyAdd" android:layout_width="72dp" android:layout_height="72dp" android:gravity="center" android:text="+" android:textColor="#8aba8a" android:textSize="22sp" android:clickable="true" android:focusable="true" android:background="@drawable/keypad_btn_bg" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.20" />

</LinearLayout>
